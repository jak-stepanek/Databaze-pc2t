package a;

import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;

import a.spoluprace.Spoluprace;

public class Test {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		Map<Integer, Employee> databaze = new HashMap<>();
		boolean bezi = true;
		while(bezi) {
			
		
			
		System.out.println("Menu databaze");
		System.out.println("1. pridání nového zamestnance");
		System.out.println("2. pridani spoluprace");
		System.out.println("3. odebrani pracovnika");
		System.out.println("4. vyhledat pracovnika");
		System.out.println("0. konec");
		int volba = sc.nextInt();
        sc.nextLine();
		switch(volba) {
		case 1:
            System.out.print("Jmeno: ");
            String jmeno = sc.nextLine();
            System.out.print("Prijmení: ");
            String prijmeni = sc.nextLine();
            System.out.print("Rok narozeni: ");
            int rok = sc.nextInt();
            
            System.out.print("Typ (1-Analytik, 2-Specialista): ");
            int typ = sc.nextInt();
            
            Employee novy;
            if (typ == 1) {
                novy = new DataAnalyst(jmeno, prijmeni, rok);
            } else {
                novy = new SecurityExpert(jmeno, prijmeni, rok);
            }
            
            databaze.put(novy.getId(), novy);
            System.out.println("Ulozeno s ID: " + novy.getId());
            break;
		case 2:
		    System.out.print("ID zamestnance, kteremu pridavame kolegu: ");
		    int idZam = sc.nextInt();
		    System.out.print("ID kolegy: ");
		    int idKol = sc.nextInt();
		    sc.nextLine();

		    System.out.println("Úroveň (1-spatna, 2-prumerna, 3-dobra): ");
		    int u = sc.nextInt();
		    Spoluprace spoluprace = 
		    	(u == 1) ? Spoluprace.SPATNA : 
                (u == 2) ? Spoluprace.PRUMERNA : 
                (u == 3) ? Spoluprace.DOBRA : null;

		    if (spoluprace == null) {
		    	System.out.println("Neplatna uroven spoluprace (zadejte 1-3)");
		    } else {
		    	Employee e = databaze.get(idZam);
		    	if (e != null && databaze.containsKey(idKol)) {
		    		e.pridejKolegu(idKol, spoluprace);
		    		System.out.println("Spolupráce pridana.");
		    	} else {
		    		System.out.println("Jedno z ID neexistuje");
		    	}
		    }
		    break;
		case 3:
			System.out.println("Zadejte ID zamestnance k odebrani: ");
			int idDel = sc.nextInt();
			if (databaze.containsKey(idDel)) {
				databaze.remove(idDel);
				for(Employee ostatni : databaze.values()) {
					ostatni.getKolegove().remove(idDel);
				}
				System.out.println("zamestnanec byl smazan");
			}
			else {
				System.out.println("ID nebylo nalezeno");
			}
			break;
		case 4:
			System.out.println("zadejte ID zamestnance");
			int idFind = sc.nextInt();
			Employee e = databaze.get(idFind);
			if(e !=null) {
				System.out.println("Jmeno: "+ e.getJmeno() );
				System.out.println("Prijmeni: "+ e.getPrijmeni() );
				System.out.println("Rok narozeni: "+ e.getRok() );
				int pocet = e.getKolegove().size();
				System.out.println("Má"+pocet+"kolegu");
				if (pocet >0) {
					int dobra = 0, prumerna = 0, spatna=0;
					
				for(Spoluprace s:e.getKolegove().values()) {
					
					if (s == Spoluprace.DOBRA) dobra++;
					else if (s == Spoluprace.PRUMERNA) prumerna++;
					else if(s == Spoluprace.SPATNA) spatna++;
					}
				System.out.println("Statistika spoluprace: Dobra: "+dobra+
						"prumerna: "+prumerna+"spatna: "+spatna);
			}
			}
				else {
					System.out.println("Id"+idFind+"nebylo v databazi nalezeno");
			}
			
        case 0:
            bezi = false;
            System.out.println("konec");
            break;

        default:
            System.out.println("Neplatna volba, zkuste to znovu.");
		}
		
	}
	}
	}

